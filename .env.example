# Provision a managed Postgres database (Neon or Supabase)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# 32+ random bytes, unique per environment; e.g. openssl rand -hex 32
SESSION_SECRET=replace-with-random-secret-longer-than-32-characters
# Owner admin username and scrypt hash generated via npm run hash-admin
ADMIN_USERNAME=owner
ADMIN_PASSWORD_HASH=scrypt:saltHex:derivedKeyHex
# Browser origin for production or http://localhost:3000 for local dev
APP_ORIGIN=http://localhost:3000
